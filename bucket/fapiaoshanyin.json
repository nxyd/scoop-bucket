{
    "version": "5.0.0",
    "description": "批量打印 PDF、OFD 及图片版电子发票的免安装工具",
    "homepage": "https://printpdf.github.io/",
    "license": "Freeware",
    "url": "https://github.com/PrintPDF/PrintPDF.github.io/releases/download/PrintPDF/PrintPDF.7z",
    "hash": "1b4aff22427e049fc58fcc252a863e80a91c9b9046f6f834029b42da77ee2626",
    "extract_dir": "发票闪印5.0.0",
    "bin": "PrintPDF.exe",
    "shortcuts": [
        [
            "PrintPDF.exe",
            "发票闪印"
        ]
    ],
    "persist": "config",
    "pre_install": [
        "$persistScript = if ($bucket) { Join-Path $bucketsdir \"$bucket\\scripts\\fapiaoshanyin.ps1\" } elseif ($url -and (Test-Path -LiteralPath $url)) { Join-Path (Split-Path (Split-Path $url)) 'scripts\\fapiaoshanyin.ps1' }",
        "if (!$persistScript -or !(Test-Path -LiteralPath $persistScript)) { throw 'Unable to locate the fapiaoshanyin persistence script.' }",
        "Copy-Item $persistScript \"$dir\\fapiaoshanyin-persist.ps1\""
    ],
    "post_install": "& \"$dir\\fapiaoshanyin-persist.ps1\" -Mode Install -Dir $dir -PersistDir $persist_dir",
    "pre_uninstall": "if (Test-Path -LiteralPath \"$dir\\fapiaoshanyin-persist.ps1\") { & \"$dir\\fapiaoshanyin-persist.ps1\" -Mode Uninstall -Dir $dir -PersistDir $persist_dir }",
    "checkver": {
        "url": "https://printpdf.github.io/version.json",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://github.com/PrintPDF/PrintPDF.github.io/releases/download/PrintPDF/PrintPDF.7z",
        "extract_dir": "发票闪印$version"
    }
}
