            "红果短剧.exe",
            "hongguo-drama"
        ]
    ],
    "shortcuts": [
        [
            "红果短剧.exe",
            "红果短剧"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://api.github.com/repos/jackotom/hongguo-drama/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jackotom/hongguo-drama/releases/download/v$version/hongguo-downloader-$version-win-x64.exe"
