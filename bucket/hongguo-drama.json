            "Remove-Item -Path ($dir + '\\$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
            "New-Item -Path \"$dir\\portable.marker\" -ItemType File -Force | Out-Null"
        ]
    },
    "bin": [
